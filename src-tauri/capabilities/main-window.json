{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Local main window may invoke typed project operations and native project dialogs.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-project-commands"
  ]
}
