{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Local main window may invoke typed project operations, native dialogs, validated ChatGPT connection actions, and scene-scoped generation.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-project-commands",
    "allow-chatgpt-commands",
    "allow-scene-generation-commands",
    "allow-runtime-info-command",
    "allow-compiled-manuscript-export"
  ]
}
